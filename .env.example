# HTTP Server
PORT=8080

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=jungle_wager
POSTGRES_SSLMODE=disable

# AWS / LocalStack SQS
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
SQS_REGION=us-east-1
SQS_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/wager-events.fifo

# Keycloak / OAuth2 JWT
JWT_SECRET=super-secret-keycloak-mock-secret-32-bytes!
JWT_ISSUER=http://localhost:8081/realms/jungle
